{
  "id": "mimic-early-prediction",
  "name": "MIMIC Early Prediction Evaluator",
  "kind": "evaluator",
  "version": "1.0.2",
  "description": "Septic shock early prediction evaluator, AUPRC scoring, counterfactual analysis, and agreement metrics.",
  "author": {
    "name": "Theta Clinical Team"
  },
  "created_at": "2026-10-18T00:00:00Z",
  "config_path": "eval/mimic/early_prediction.yaml",
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "paradigms": [
    "supervised",
    "offline_rl"
  ],
  "config_paths": [
    "eval/mimic/early_prediction.yaml"
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "window_hours": {
        "type": "integer"
      },
      "eval_batch_size": {
        "type": "integer"
      },
      "metrics": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "opt_thresh": {
        "type": "number"
      },
      "ep_ckpt_root": {
        "type": "string"
      }
    }
  },
  "dependencies": {
    "components": [],
    "pip": []
  },
  "storage_version": 3,
  "api_version": 1,
  "capabilities": [
    {
      "id": "EPSepsisDataModule",
      "kind": "component",
      "entry_point": "data_module.py:EPSepsisDataModule",
      "aliases": [
        "SepsisDataModule"
      ]
    },
    {
      "id": "mimic-early-prediction",
      "kind": "evaluator",
      "entry_point": "eval_logic.py:compute_ep_eval_data",
      "aliases": [
        "early_prediction"
      ]
    }
  ],
  "payload": {
    "implementations": [
      "data_module.py",
      "eval_logic.py",
      "__init__.py",
      "lightning_module.py",
      "model.py"
    ],
    "resources": [],
    "configs": {
      "eval/mimic/early_prediction.yaml": "configs/eval/mimic/early_prediction.yaml"
    }
  },
  "exports": {
    "SepsisLSTM": "model.py:SepsisLSTM",
    "SepsisTransformer": "model.py:SepsisTransformer",
    "compute_ep_eval_data": "eval_logic.py:compute_ep_eval_data",
    "compute_volatility_features": "model.py:compute_volatility_features",
    "evaluate_lstm_model": "model.py:evaluate_lstm_model",
    "evaluate_transformer_model": "model.py:evaluate_transformer_model",
    "plot_agreement_vs_shock": "eval_logic.py:plot_agreement_vs_shock",
    "plot_ep_shock_over_tau": "eval_logic.py:plot_ep_shock_over_tau",
    "write_counterfactual_table": "eval_logic.py:write_counterfactual_table"
  }
}
