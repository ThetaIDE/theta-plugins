{
  "id": "reward-shaping",
  "name": "Potential-Based Reward Shaping",
  "kind": "evaluator",
  "version": "1.1.0",
  "description": "Potential-based reward shaping hooks using Early Prediction (EP) septic shock classifiers for offline RL.",
  "author": {
    "name": "Theta Clinical Team"
  },
  "created_at": "2026-10-18T00:00:00Z",
  "config_path": "eval/mimic/reward_shaping.yaml",
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "config_paths": [
    "eval/mimic/reward_shaping.yaml"
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "lambda_coef": {
        "type": "number"
      },
      "gamma": {
        "type": "number"
      },
      "window_hours": {
        "type": "integer"
      },
      "use_volatility": {
        "type": "boolean"
      },
      "ep_ckpt_dir": {
        "type": [
          "string",
          "null"
        ],
        "description": "EP checkpoint directory; relative to the workspace. Null uses the workspace's results/checkpoints/early_prediction."
      },
      "ep_architecture": {
        "type": "string"
      },
      "cql_ckpt_dir": {
        "type": [
          "string",
          "null"
        ],
        "description": "CQL checkpoint file or directory for V(s); required by V-augmented EP models."
      }
    }
  },
  "dependencies": {
    "components": [
      "mimic-early-prediction"
    ],
    "pip": []
  },
  "storage_version": 3,
  "api_version": 1,
  "capabilities": [
    {
      "id": "reward_shaping",
      "kind": "evaluator",
      "entry_point": "reward_shaping.py:EPRewardShaper",
      "aliases": [
        "EPRewardShaper",
        "reward-shaping"
      ]
    }
  ],
  "payload": {
    "implementations": [
      "__init__.py",
      "reward_shaping.py"
    ],
    "resources": [],
    "configs": {
      "eval/mimic/reward_shaping.yaml": "configs/eval/mimic/reward_shaping.yaml"
    }
  }
}
