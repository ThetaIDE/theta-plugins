{
  "id": "d3rlpy-suite",
  "name": "d3rlpy Offline RL Suite",
  "kind": "method",
  "version": "2.1.0",
  "description": "Standard offline reinforcement learning algorithms (CQL, IQL, TD3+BC, BC) powered by d3rlpy.",
  "author": "Takuma Seno & d3rlpy Contributors",
  "tags": [
    "offline-rl",
    "cql",
    "iql",
    "td3-bc",
    "bc",
    "d3rlpy",
    "baselines"
  ],
  "storage_version": 3,
  "api_version": 1,
  "dependencies": {
    "pip": [
      "d3rlpy>=2.8,<3",
      "gymnasium"
    ],
    "components": []
  },
  "capabilities": [
    {
      "id": "d3rlpy/bc",
      "kind": "algorithm",
      "entry_point": "d3rlpy_backend.py:execute",
      "execution_contract": 1,
      "backend": "d3rlpy",
      "execution_features": {
        "evaluation": "provider",
        "resume_modes": [
          "inference"
        ],
        "checkpoint_formats": [
          "d3rlpy.d3"
        ],
        "tuning": false,
        "winner_promotion": false,
        "episode_outcomes": false
      },
      "resource_hints": {
        "accelerator": false
      },
      "aliases": [],
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "offline_rl"
          ]
        },
        {
          "level": "block",
          "config": "data_module",
          "present": false
        }
      ]
    },
    {
      "id": "d3rlpy/cql",
      "kind": "algorithm",
      "entry_point": "d3rlpy_backend.py:execute",
      "execution_contract": 1,
      "backend": "d3rlpy",
      "execution_features": {
        "evaluation": "provider",
        "resume_modes": [
          "inference"
        ],
        "checkpoint_formats": [
          "d3rlpy.d3"
        ],
        "tuning": false,
        "winner_promotion": false,
        "episode_outcomes": false
      },
      "resource_hints": {
        "accelerator": false
      },
      "aliases": [],
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "offline_rl"
          ]
        },
        {
          "level": "block",
          "config": "data_module",
          "present": false
        }
      ]
    },
    {
      "id": "d3rlpy/iql",
      "kind": "algorithm",
      "entry_point": "d3rlpy_backend.py:execute",
      "execution_contract": 1,
      "backend": "d3rlpy",
      "execution_features": {
        "evaluation": "provider",
        "resume_modes": [
          "inference"
        ],
        "checkpoint_formats": [
          "d3rlpy.d3"
        ],
        "tuning": false,
        "winner_promotion": false,
        "episode_outcomes": false
      },
      "resource_hints": {
        "accelerator": false
      },
      "aliases": [],
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "offline_rl"
          ]
        },
        {
          "level": "block",
          "config": "data_module",
          "present": false
        }
      ]
    },
    {
      "id": "d3rlpy/td3_bc",
      "kind": "algorithm",
      "entry_point": "d3rlpy_backend.py:execute",
      "execution_contract": 1,
      "backend": "d3rlpy",
      "execution_features": {
        "evaluation": "provider",
        "resume_modes": [
          "inference"
        ],
        "checkpoint_formats": [
          "d3rlpy.d3"
        ],
        "tuning": false,
        "winner_promotion": false,
        "episode_outcomes": false
      },
      "resource_hints": {
        "accelerator": false
      },
      "aliases": [],
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "offline_rl"
          ]
        },
        {
          "level": "block",
          "config": "data_module",
          "present": false
        }
      ]
    },
    {
      "id": "d3rlpy/vector",
      "kind": "model",
      "entry_point": "d3rlpy_backend.py:create_encoder",
      "backend": "d3rlpy",
      "aliases": [],
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "offline_rl"
          ]
        }
      ]
    }
  ],
  "payload": {
    "implementations": [
      "d3rlpy_backend.py"
    ],
    "resources": [
      "requirements.txt"
    ],
    "configs": {
      "agent/d3rlpy/bc.yaml": "configs/agent/d3rlpy/bc.yaml",
      "agent/d3rlpy/cql.yaml": "configs/agent/d3rlpy/cql.yaml",
      "agent/d3rlpy/iql.yaml": "configs/agent/d3rlpy/iql.yaml",
      "agent/d3rlpy/td3_bc.yaml": "configs/agent/d3rlpy/td3_bc.yaml",
      "model/d3rlpy/vector.yaml": "configs/model/d3rlpy/vector.yaml"
    }
  },
  "config_paths": [
    "agent/d3rlpy/bc.yaml",
    "agent/d3rlpy/cql.yaml",
    "agent/d3rlpy/iql.yaml",
    "agent/d3rlpy/td3_bc.yaml",
    "model/d3rlpy/vector.yaml"
  ],
  "config_path": "agent/d3rlpy/bc.yaml",
  "parameter_schema": {
    "type": "object",
    "properties": {},
    "x-theta-config-schemas": {
      "agent/d3rlpy/bc.yaml": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "backend": {
            "type": "string",
            "enum": [
              "d3rlpy"
            ]
          },
          "learning_rate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "n_steps": {
            "type": "integer",
            "minimum": 1
          },
          "batch_size": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "agent/d3rlpy/cql.yaml": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "backend": {
            "type": "string",
            "enum": [
              "d3rlpy"
            ]
          },
          "learning_rate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "n_steps": {
            "type": "integer",
            "minimum": 1
          },
          "batch_size": {
            "type": "integer",
            "minimum": 1
          },
          "gamma": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      },
      "agent/d3rlpy/iql.yaml": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "backend": {
            "type": "string",
            "enum": [
              "d3rlpy"
            ]
          },
          "learning_rate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "n_steps": {
            "type": "integer",
            "minimum": 1
          },
          "batch_size": {
            "type": "integer",
            "minimum": 1
          },
          "expectile": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "weight_temp": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "gamma": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      },
      "agent/d3rlpy/td3_bc.yaml": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "backend": {
            "type": "string",
            "enum": [
              "d3rlpy"
            ]
          },
          "learning_rate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "n_steps": {
            "type": "integer",
            "minimum": 1
          },
          "batch_size": {
            "type": "integer",
            "minimum": 1
          },
          "alpha": {
            "type": "number",
            "minimum": 0
          },
          "gamma": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      },
      "model/d3rlpy/vector.yaml": {
        "type": "object",
        "properties": {
          "architecture": {
            "type": "string"
          },
          "hidden_units": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "activation": {
            "type": "string",
            "enum": [
              "relu",
              "tanh",
              "elu"
            ]
          }
        }
      }
    }
  }
}
