{
  "id": "sb3-suite",
  "name": "Stable-Baselines3 Suite",
  "version": "1.1.1",
  "kind": "method",
  "description": "Standard reinforcement learning algorithms (PPO, DQN, A2C, SAC) powered by Stable-Baselines3.",
  "author": "DLR-RM & SB3 Contributors",
  "tags": [
    "rl",
    "baselines",
    "ppo",
    "dqn",
    "sb3"
  ],
  "dependencies": {
    "pip": [
      "stable-baselines3",
      "gymnasium",
      "shimmy"
    ],
    "components": []
  },
  "parameter_schema": {
    "type": "object",
    "properties": {},
    "x-theta-config-schemas": {
      "in/config/agent/sb3/a2c.yaml": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "policy": {
            "type": "string",
            "enum": [
              "MlpPolicy",
              "CnnPolicy",
              "MultiInputPolicy"
            ]
          },
          "learning_rate": {
            "type": "string"
          },
          "n_steps": {
            "type": "integer"
          },
          "gamma": {
            "type": "number"
          },
          "ent_coef": {
            "type": "number"
          },
          "vf_coef": {
            "type": "number"
          },
          "entrypoint": {
            "type": "string"
          },
          "learning_rate_schedule": {
            "type": "string",
            "enum": [
              "constant",
              "linear"
            ],
            "default": "constant",
            "description": "Constant rate or linear decay across the training budget."
          },
          "learning_rate_final": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "description": "Final rate when using a linear learning-rate schedule."
          }
        }
      },
      "in/config/agent/sb3/dqn.yaml": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "policy": {
            "type": "string",
            "enum": [
              "MlpPolicy",
              "CnnPolicy",
              "MultiInputPolicy"
            ]
          },
          "learning_rate": {
            "type": "string"
          },
          "buffer_size": {
            "type": "integer"
          },
          "learning_starts": {
            "type": "integer"
          },
          "batch_size": {
            "type": "integer"
          },
          "gamma": {
            "type": "number"
          },
          "train_freq": {
            "type": "integer"
          },
          "target_update_interval": {
            "type": "integer"
          },
          "exploration_fraction": {
            "type": "number"
          },
          "entrypoint": {
            "type": "string"
          },
          "learning_rate_schedule": {
            "type": "string",
            "enum": [
              "constant",
              "linear"
            ],
            "default": "constant",
            "description": "Constant rate or linear decay across the training budget."
          },
          "learning_rate_final": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "description": "Final rate when using a linear learning-rate schedule."
          }
        }
      },
      "in/config/agent/sb3/ppo.yaml": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "policy": {
            "type": "string",
            "enum": [
              "MlpPolicy",
              "CnnPolicy",
              "MultiInputPolicy"
            ]
          },
          "learning_rate": {
            "type": "string"
          },
          "batch_size": {
            "type": "integer"
          },
          "n_steps": {
            "type": "integer"
          },
          "n_epochs": {
            "type": "integer"
          },
          "gamma": {
            "type": "number"
          },
          "gae_lambda": {
            "type": "number"
          },
          "clip_range": {
            "type": "number"
          },
          "entrypoint": {
            "type": "string"
          },
          "learning_rate_schedule": {
            "type": "string",
            "enum": [
              "constant",
