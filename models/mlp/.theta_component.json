{
  "id": "mlp",
  "name": "Multi-Layer Perceptron (MLP)",
  "kind": "model",
  "version": "1.2.0",
  "description": "Standard Multi-Layer Perceptron neural network architectures for classification, value estimation, and policy modeling.",
  "author": {
    "name": "Theta-IDE Team"
  },
  "config_path": "model/basics/mlp.yaml",
  "config_paths": [
    "model/basics/mlp.yaml",
    "model/basics/mlp_classifier.yaml"
  ],
  "suite": "thetalib",
  "hidden": true,
  "parameter_schema": {
    "type": "object",
    "properties": {},
    "x-theta-config-schemas": {
      "model/basics/mlp.yaml": {
        "type": "object",
        "properties": {
          "hidden_dims": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "activation": {
            "type": "string",
            "enum": [
              "relu",
              "gelu",
              "tanh",
              "elu",
              "silu",
              "sigmoid",
              "leaky_relu",
              "identity"
            ]
          }
        }
      },
      "model/basics/mlp_classifier.yaml": {
        "type": "object",
        "properties": {
          "hidden_dims": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "activation": {
            "type": "string",
            "enum": [
              "relu",
              "gelu",
              "tanh",
              "elu",
              "silu",
              "sigmoid",
              "leaky_relu",
              "identity"
            ]
          },
          "dropout": {
            "type": "number"
          }
        }
      }
    }
  },
  "dependencies": {
    "components": [
      "nature_cnn"
    ],
    "pip": []
  },
  "storage_version": 3,
  "api_version": 1,
  "capabilities": [
    {
      "id": "standard_mlp_actor",
      "kind": "model",
      "entry_point": "mlp_model.py:StandardMLPActor",
      "aliases": [
        "standard_mlp",
        "neural_blender_mlp"
      ],
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "online_rl",
            "offline_rl",
            "supervised"
          ]
        }
      ]
    },
    {
      "id": "value_network",
      "kind": "model",
      "entry_point": "mlp_model.py:ValueNetwork",
      "aliases": [
        "cnn_value_network"
      ],
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "online_rl",
            "offline_rl",
            "supervised"
          ]
        }
      ]
    },
    {
      "id": "mlp",
      "kind": "model",
      "entry_point": "mlp_model.py:MLPQNetwork",
      "aliases": [
        "mlpqnetwork",
        "basics/mlp"
      ],
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "online_rl",
            "offline_rl",
            "supervised"
          ]
        }
      ]
    },
    {
      "id": "mlp_value_network",
      "kind": "model",
      "entry_point": "mlp_model.py:MLPValueNetwork",
      "aliases": [],
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "online_rl",
            "offline_rl",
            "supervised"
          ]
        }
      ]
    },
    {
      "id": "q_network",
      "kind": "model",
      "entry_point": "mlp_model.py:QNetwork",
      "aliases": [
        "cnn_q_network"
      ],
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "online_rl",
            "offline_rl",
            "supervised"
          ]
        }
      ]
    },
    {
      "id": "mlp_classifier",
      "kind": "model",
      "entry_point": "mlp_model.py:MLPClassifier",
      "aliases": [
        "tabular_classifier",
        "classifier",
        "basics/mlp_classifier"
      ],
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "online_rl",
            "offline_rl",
            "supervised"
          ]
        }
      ]
    },
    {
      "id": "MLPClassifierLightningModule",
      "kind": "component",
      "entry_point": "training.py:MLPClassifierLightningModule"
    }
  ],
  "payload": {
    "implementations": [
      "__init__.py",
      "mlp_model.py",
      "training.py"
    ],
    "resources": [],
    "configs": {
      "model/basics/mlp.yaml": "configs/model/basics/mlp.yaml",
      "model/basics/mlp_classifier.yaml": "configs/model/basics/mlp_classifier.yaml"
    }
  }
}
