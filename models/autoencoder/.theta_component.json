            "items": {
              "type": "integer"
            }
          }
        }
      },
      "model/basics/dense_autoencoder.yaml": {
        "type": "object",
        "properties": {
          "latent_dim": {
            "type": "integer"
          },
          "hidden_dims": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    }
  },
  "dependencies": {
    "components": [],
    "pip": []
  },
  "storage_version": 3,
  "api_version": 1,
  "capabilities": [
