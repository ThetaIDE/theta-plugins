{
  "id": "neumann",
  "name": "NEUMANN Neural Symbolic Reasoner",
  "kind": "model",
  "version": "1.0.7",
  "description": "Neuro-symbolic message passing reasoner over logic graphs.",
  "author": {
    "name": "Hikaru Shindo"
  },
  "config_path": "in/config/model/neumann.yaml",
  "config_paths": [
    "in/config/model/neumann.yaml"
  ],
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "parameter_schema": {
    "type": "object",
    "properties": {
      "rules": {
        "type": "string",
        "x-theta-domain": "ruleset",
        "x-theta-actions": [
          {
            "type": "open-in-editor",
            "label": "Open rules folder",
            "handler": {
              "path": "package://neumann/editor_actions.py",
              "function": "rules_edit_targets"
            }
          }
        ],
        "description": "Environment-scoped ruleset name, or environment/name in an unscoped model profile."
      },
      "logic_type": {
        "type": "string"
      }
    }
  },
  "dependencies": {
    "components": [
      "nsfr"
    ],
    "pip": [
      "torch-geometric",
      "networkx",
      "joblib"
    ]
  },
  "storage_version": 2,
  "api_version": 1,
  "capabilities": [
    {
      "id": "neumann",
      "kind": "model",
      "entry_point": "common.py:get_neumann_model",
      "aliases": []
    }
  ],
  "payload": {
    "implementations": [
      "logic_utils.py",
      "reasoning_graph.py",
      "neumann.py",
      "soft_logic.py",
      "editor_actions.py",
      "__init__.py",
      "refinement.py",
      "neumann_utils.py",
      "facts_converter.py",
      "common.py",
      "valuation.py",
      "message_passing.py",
      "scatter.py",
      "valuation_func.py",
      "torch_utils.py",
      "fol/__init__.py",
      "fol/logic.py",
      "fol/data_utils.py",
      "fol/language.py",
      "fol/logic_ops.py",
      "fol/exp_parser.py"
    ],
    "resources": [
      "lark",
      "fol/exp.lark"
    ],
    "configs": {
      "in/config/model/neumann.yaml": "configs/model/neumann.yaml"
    }
  }
}
