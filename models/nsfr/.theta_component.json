{
  "id": "nsfr",
  "name": "Neural Symbolic Forward Reasoner (NSFR)",
  "kind": "model",
  "version": "1.1.0",
  "description": "Differentiable forward reasoning engine computing soft valuations over first-order logic clauses.",
  "author": {
    "name": "Hikaru Shindo"
  },
  "config_path": "model/nsfr.yaml",
  "config_paths": [
    "model/nsfr.yaml"
  ],
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "parameter_schema": {
    "type": "object",
    "properties": {
      "rules": {
        "type": "string",
        "x-theta-domain": "ruleset",
        "x-theta-actions": [
          {
            "type": "open-in-editor",
            "label": "Open rules folder",
            "handler": {
              "path": "package://nsfr/editor_actions.py",
              "function": "rules_edit_targets"
            }
          }
        ],
        "description": "Environment-scoped ruleset name, or environment/name in an unscoped model profile."
      },
      "logic_type": {
        "type": "string"
      }
    }
  },
  "dependencies": {
    "components": [],
    "pip": [
      "lark",
      "tqdm"
    ]
  },
  "rules_root": "resources/rules",
  "storage_version": 3,
  "api_version": 1,
  "capabilities": [
    {
      "id": "nsfr",
      "kind": "model",
      "entry_point": "common.py:get_nsfr_model",
      "aliases": []
    }
  ],
  "payload": {
    "implementations": [
      "nsfr.py",
      "nsfr_beam.py",
      "mode_declaration.py",
      "editor_actions.py",
      "__init__.py",
      "refinement.py",
      "facts_converter.py",
      "results_plusplus.py",
      "common.py",
      "valuation.py",
      "clause_generator.py",
      "infer.py",
      "tensor_encoder.py",
      "fol/__init__.py",
      "fol/logic.py",
      "fol/data_utils.py",
      "fol/language.py",
      "fol/logic_ops.py",
      "fol/exp_parser.py",
      "utils/neural.py",
      "utils/__init__.py",
      "utils/logic.py",
      "utils/common.py",
      "utils/valuation.py",
      "utils/beam.py",
      "utils/torch.py"
    ],
    "resources": [
      "resources",
      "lark",
      "fol/exp.lark"
    ],
    "configs": {
      "model/nsfr.yaml": "configs/model/nsfr.yaml"
    }
  },
  "exports": {
    "FactsConverter": "facts_converter.py:FactsConverter",
    "ValuationModule": "valuation.py:ValuationModule",
    "bool_to_probs": "utils/common.py:bool_to_probs",
    "build_infer_module": "utils/logic.py:build_infer_module",
    "get_blender_lang": "utils/logic.py:get_blender_lang",
    "get_blender_nsfr_model": "common.py:get_blender_nsfr_model",
    "get_lang": "utils/logic.py:get_lang",
    "get_nsfr_model": "common.py:get_nsfr_model",
    "load_module": "utils/common.py:load_module",
    "subs_list": "fol/logic_ops.py:subs_list",
    "unify": "fol/logic_ops.py:unify"
  }
}
