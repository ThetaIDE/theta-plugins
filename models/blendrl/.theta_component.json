{
  "id": "blendrl",
  "name": "BlendRL Neural-Symbolic Policy",
  "kind": "model",
  "version": "1.4.0",
  "description": "Modular actor-critic architecture combining neural networks and symbolic reasoners with adaptive blending.",
  "author": {
    "name": "NeSyRL Contributors",
    "github": "CameronEgb"
  },
  "repository": "https://github.com/CameronEgb/Offline-BlendRL",
  "license": "MIT",
  "tags": [
    "blendrl",
    "hybrid",
    "neural-symbolic",
    "nsfr",
    "logic",
    "rl"
  ],
  "dependencies": {
    "components": [
      "dnn",
      "nsfr",
      "neumann"
    ],
    "pip": [
      "captum",
      "lark"
    ]
  },
  "config_path": "model/blendrl.yaml",
  "config_paths": [
    "model/blendrl.yaml",
    "plot/blendrl/blend_routing.yaml",
    "data/blendrl/symbolic_state.yaml",
    "data/blendrl/cartpole_state.yaml"
  ],
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "parameter_schema": {
    "type": "object",
    "required": [
      "blender_model"
    ],
    "properties": {
      "actor_mode": {
        "type": "string",
        "enum": [
          "hybrid",
          "logic",
          "neural"
        ]
      },
      "blender": {
        "type": "string",
        "enum": [
          "neural",
          "symbolic"
        ],
        "description": "Policy used to produce blending weights."
      },
      "blend_function": {
        "type": "string",
        "enum": [
          "softmax",
          "gumbel_softmax"
        ],
        "description": "Blending function. SB3 currently requires softmax."
      },
      "blend_q_values": {
        "type": "boolean"
      },
      "blend_ent_coef": {
        "type": "number",
        "description": "Blend entropy coefficient. SB3 currently requires zero or null."
      },
      "logic_lr": {
        "type": [
          "number",
          "null"
        ],
        "description": "Logic optimizer learning rate; null inherits the agent learning rate."
      },
      "blender_lr": {
        "type": [
          "number",
          "null"
        ],
        "description": "Blender optimizer learning rate; null inherits the agent learning rate."
      },
      "neural": {
        "type": [
          "string",
          "object"
        ],
        "x-theta-domain": "model",
        "description": "Neural policy and critic module."
      },
      "symbolic": {
        "type": [
          "string",
          "object"
        ],
        "x-theta-domain": "model",
        "description": "Symbolic reasoning module."
      },
      "monitoring_interval": {
        "type": "integer",
        "minimum": 0,
        "description": "SB3 environment steps between routing summaries; 0 disables."
      },
      "monitoring_max_samples": {
        "type": "integer",
        "minimum": 0,
        "description": "Maximum recent observations to save for routing plots; 0 disables."
      },
      "logic_confidence_floor": {
        "type": "number",
        "minimum": 0,
        "exclusiveMaximum": 1,
        "description": "Truth scores at or below this floor abstain; stronger evidence blends with the default action distribution."
      },
      "blender_model": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "x-theta-domain": "model",
        "description": "Model used to produce blender weights."
      },
      "symbolic_state": {
        "type": [
          "string",
          "object"
        ],
        "x-theta-domain": "datamodule",
        "x-theta-contract": "symbolic_state/v1",
        "description": "Builder that turns observations into [batch, objects, features] symbolic states for the logic actor and symbolic blender."
      }
    },
    "x-theta-config-schemas": {
      "plot/blendrl/blend_routing.yaml": {
        "type": "object",
        "properties": {
          "output_subdir": {
            "type": "string"
          },
          "figsize": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "dpi": {
            "type": "integer",
            "minimum": 1
          },
          "smoothing_window": {
            "type": "integer",
            "minimum": 1
          },
          "x_axis": {
            "type": "string"
          },
          "authority_threshold": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1
          },
          "tsne": {
            "type": "boolean"
          }
        }
      },
      "data/blendrl/symbolic_state.yaml": {
        "type": "object",
        "properties": {
          "object_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "default": 1
          },
          "feature_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "default": null
          },
          "builder": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "additionalProperties": false
      },
      "data/blendrl/cartpole_state.yaml": {
        "type": "object",
        "properties": {
          "object_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "default": 1
          },
          "feature_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "default": null
          },
          "builder": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "additionalProperties": false
      }
    }
  },
  "storage_version": 3,
  "api_version": 1,
  "capabilities": [
    {
      "id": "blendrl",
      "kind": "model",
      "entry_point": "agents/blender_agent.py:BlenderActorCritic",
      "aliases": [],
      "monitoring": {
        "provides": [],
        "catalog": "monitor_catalog.py:describe"
      },
      "monitor_defaults": {
        "blend_reliance": {
          "component": "blendrl/reliance",
          "enabled": false
        }
      },
      "monitoring_access": [
        "blendrl.expert_interventions.v1"
      ],
      "requires": [
        {
          "level": "block",
          "config": "model.symbolic_state",
          "present": true,
          "when": {
            "model.actor_mode": [
              "hybrid",
              "logic"
            ]
          },
          "message": "BlendRL's hybrid and logic actors need a symbolic state builder: select model.symbolic_state."
        },
        {
          "level": "block",
          "config": "model.symbolic_state",
          "present": true,
          "when": {
            "model.blender": [
              "symbolic"
            ]
          },
          "message": "BlendRL's symbolic blender needs a symbolic state builder: select model.symbolic_state."
        }
      ]
    },
    {
      "id": "blend_routing",
      "kind": "plotter",
      "entry_point": "plot/blendrl/routing.py:BlendRoutingPlotter",
      "aliases": []
    },
    {
      "id": "blendrl/reliance",
      "kind": "monitor",
      "entry_point": "reliance_monitor.py:BlendReliance",
      "monitoring": {
        "catalog": "reliance_catalog.py:describe"
      },
      "parameter_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "integer",
            "minimum": 0
          },
          "reference_action": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "hooks": [
        "probe_forward.v1",
        "post_update.v1",
        "module_interventions.v1",
        "blendrl.expert_interventions.v1",
        "policy_probabilities.v1"
      ]
    },
    {
      "id": "blendrl_symbolic_state",
      "kind": "datamodule",
      "entry_point": "symbolic_state.py:SymbolicStateLoader",
      "parameter_schema": {
        "type": "object",
        "properties": {
          "object_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "default": 1
          },
          "feature_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "default": null
          },
          "builder": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "additionalProperties": false
      },
      "provides": [
        "symbolic_state/v1"
      ],
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "online_rl",
            "offline_rl"
          ]
        }
      ]
    }
  ],
  "payload": {
    "implementations": [
      "monitoring.py",
      "__init__.py",
      "agents/blender_agent.py",
      "agents/__init__.py",
      "plot/blendrl/__init__.py",
      "plot/blendrl/routing.py",
      "monitor_catalog.py",
      "reliance_monitor.py",
      "reliance_catalog.py",
      "symbolic_state.py"
    ],
    "resources": [],
    "configs": {
      "model/blendrl.yaml": "configs/model/blendrl.yaml",
      "plot/blendrl/blend_routing.yaml": "configs/plot/blendrl/blend_routing.yaml",
      "data/blendrl/symbolic_state.yaml": "configs/data/blendrl/symbolic_state.yaml",
      "data/blendrl/cartpole_state.yaml": "configs/data/blendrl/cartpole_state.yaml"
    }
  }
}
