{
  "id": "blendrl",
  "name": "BlendRL Neural-Symbolic Policy",
  "kind": "model",
  "version": "1.3.2",
  "description": "Modular actor-critic architecture combining neural networks and symbolic reasoners with adaptive blending.",
  "author": {
    "name": "NeSyRL Contributors",
    "github": "CameronEgb"
  },
  "repository": "https://github.com/CameronEgb/Offline-BlendRL",
  "license": "MIT",
  "tags": [
    "blendrl",
    "hybrid",
    "neural-symbolic",
    "nsfr",
    "logic",
    "rl"
  ],
  "dependencies": {
    "components": [
      "dnn",
      "nsfr",
      "neumann"
    ],
    "pip": [
      "captum"
    ]
  },
  "config_path": "model/blendrl.yaml",
  "config_paths": [
    "model/blendrl.yaml",
    "plot/blendrl/blend_routing.yaml"
  ],
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "parameter_schema": {
    "type": "object",
    "properties": {
      "actor_mode": {
        "type": "string",
        "enum": [
          "hybrid",
          "logic",
          "neural"
        ]
      },
      "blender": {
        "type": "string",
        "enum": [
          "neural",
          "symbolic"
        ],
        "description": "Policy used to produce blending weights."
      },
      "blend_function": {
        "type": "string",
        "enum": [
          "softmax",
          "gumbel_softmax"
        ],
        "description": "Blending function. SB3 currently requires softmax."
      },
      "blend_q_values": {
        "type": "boolean"
      },
      "blend_ent_coef": {
        "type": "number",
        "description": "Blend entropy coefficient. SB3 currently requires zero or null."
      },
      "logic_lr": {
        "type": [
          "number",
          "null"
        ],
        "description": "Logic optimizer learning rate; null inherits the agent learning rate."
      },
      "blender_lr": {
        "type": [
          "number",
          "null"
        ],
        "description": "Blender optimizer learning rate; null inherits the agent learning rate."
      },
      "neural": {
        "type": [
          "string",
          "object"
        ],
        "x-theta-domain": "model",
        "description": "Neural policy and critic module."
      },
      "symbolic": {
        "type": [
          "string",
          "object"
        ],
        "x-theta-domain": "model",
        "description": "Symbolic reasoning module."
      },
      "monitoring_interval": {
        "type": "integer",
        "minimum": 0,
        "description": "SB3 environment steps between routing summaries; 0 disables."
      },
      "monitoring_max_samples": {
        "type": "integer",
        "minimum": 0,
        "description": "Maximum recent observations to save for routing plots; 0 disables."
      },
      "logic_confidence_floor": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0,
        "exclusiveMaximum": 1,
        "description": "Truth scores at or below this floor abstain; stronger evidence blends with the default action distribution. Null preserves legacy normalization for historical checkpoints."
      },
      "blender_model": {
        "type": "object",
        "x-theta-domain": "model",
        "description": "Model used to produce blender weights.",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "x-theta-config-schemas": {
      "plot/blendrl/blend_routing.yaml": {
        "type": "object",
        "properties": {
          "output_subdir": {
            "type": "string"
          },
          "figsize": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "dpi": {
            "type": "integer",
            "minimum": 1
          },
          "smoothing_window": {
            "type": "integer",
            "minimum": 1
          },
          "x_axis": {
            "type": "string"
          },
          "authority_threshold": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 1
          },
          "tsne": {
            "type": "boolean"
          }
        }
      }
    },
    "required": [
      "blender_model"
    ]
  },
  "storage_version": 3,
  "api_version": 1,
  "capabilities": [
    {
      "id": "blendrl",
      "kind": "model",
      "entry_point": "agents/blender_agent.py:BlenderActorCritic",
      "aliases": [
        "blender"
      ]
    },
    {
      "id": "blend_routing",
      "kind": "plotter",
      "entry_point": "plot/blendrl/routing.py:BlendRoutingPlotter",
      "aliases": []
    }
  ],
  "payload": {
    "implementations": [
      "monitoring.py",
      "__init__.py",
      "agents/blender_agent.py",
      "agents/__init__.py",
      "plot/blendrl/__init__.py",
      "plot/blendrl/routing.py"
    ],
    "resources": [],
    "configs": {
      "model/blendrl.yaml": "configs/model/blendrl.yaml",
      "plot/blendrl/blend_routing.yaml": "configs/plot/blendrl/blend_routing.yaml"
    }
  }
}
