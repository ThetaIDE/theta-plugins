{
  "id": "dnn",
  "name": "Deep Neural Network (MLP)",
  "kind": "model",
  "version": "1.1.1",
  "description": "Standard Multi-Layer Perceptron (DNN) wrapping PyTorch Linear, LayerNorm, and Dueling Q-value heads.",
  "author": {
    "name": "Theta-IDE Team"
  },
  "config_path": "model/basics/dnn.yaml",
  "config_paths": [
    "model/basics/dnn.yaml"
  ],
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "suite": "thetalib",
  "hidden": true,
  "parameter_schema": {
    "type": "object",
    "properties": {
      "hidden_sizes": {
        "type": "array",
        "items": {
          "type": "integer"
        }
      },
      "activation": {
        "type": "string",
        "enum": [
          "relu",
          "gelu",
          "tanh",
          "elu",
          "silu",
          "sigmoid",
          "leaky_relu",
          "identity"
        ]
      },
      "shared_features": {
        "type": "boolean",
        "default": true,
        "description": "Share policy/value features. Disable for independent PPO actor and critic networks."
      },
      "dueling": {
        "type": "boolean",
        "description": "Use dueling Q-value heads; defaults to enabled for widths >=128."
      }
    }
  },
  "dependencies": {
    "components": [],
    "pip": []
  },
  "storage_version": 3,
  "api_version": 1,
  "capabilities": [
    {
      "id": "dnn",
      "kind": "model",
      "entry_point": "dnn_model.py:DNNModel",
      "aliases": [
        "basics/dnn"
      ]
    }
  ],
  "payload": {
    "implementations": [
      "__init__.py",
      "dnn_model.py"
    ],
    "resources": [],
    "configs": {
      "model/basics/dnn.yaml": "configs/model/basics/dnn.yaml"
    }
  }
}
