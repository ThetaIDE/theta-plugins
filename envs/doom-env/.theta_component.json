{
  "id": "doom-env",
  "name": "ViZDoom Environment",
  "kind": "env",
  "version": "1.2.0",
  "description": "ViZDoom visual reinforcement learning environment for Doom scenario benchmarks.",
  "author": {
    "name": "ViZDoom Team"
  },
  "repository": "https://github.com/Farama-Foundation/ViZDoom",
  "license": "MIT",
  "tags": [
    "doom",
    "vizdoom",
    "reinforcement-learning",
    "visual"
  ],
  "config_path": "env/doom.yaml",
  "dependencies": {
    "components": [
      "thetalib"
    ],
    "pip": [
      "vizdoom"
    ]
  },
  "parameter_schema": {
    "type": "object",
    "properties": {
      "monitor_metric": {
        "type": "string"
      },
      "offline_only": {
        "type": "boolean"
      },
      "preprocess_on_load": {
        "type": "boolean"
      },
      "env_id": {
        "type": "string"
      },
      "num_envs": {
        "type": "integer"
      },
      "num_steps": {
        "type": "integer"
      },
      "gamma": {
        "type": "number"
      },
      "gae_lambda": {
        "type": "number"
      },
      "rules": {
        "type": "string"
      },
      "default_plots": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "config_paths": [
    "env/doom.yaml"
  ],
  "storage_version": 3,
  "api_version": 1,
  "capabilities": [
    {
      "id": "doom-env",
      "kind": "env",
      "entry_point": "env_vectorized.py:VectorizedNudgeEnv",
      "aliases": [
        "doom"
      ],
      "resource_root": ".",
      "requires": [
        {
          "level": "block",
          "config": "paradigm",
          "in": [
            "online_rl"
          ]
        }
      ]
    }
  ],
  "payload": {
    "implementations": [
      "env_vectorized.py",
      "env.py",
      "actions.py",
      "mlp.py",
      "valuation.py"
    ],
    "resources": [],
    "configs": {
      "env/doom.yaml": "configs/env/doom.yaml"
    }
  }
}
