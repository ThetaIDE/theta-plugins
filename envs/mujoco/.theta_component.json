{
  "id": "robotics-mujoco",
  "name": "Gymnasium MuJoCo Robotics",
  "kind": "env",
  "version": "1.2.0",
  "description": "Continuous-control robotics benchmarks from Gymnasium MuJoCo: Ant, HalfCheetah, Hopper, Walker2d, and Humanoid.",
  "author": {
    "name": "Theta-IDE Team"
  },
  "config_paths": [
    "env/mujoco/ant.yaml",
    "env/mujoco/half_cheetah.yaml",
    "env/mujoco/hopper.yaml",
    "env/mujoco/humanoid.yaml",
    "env/mujoco/walker2d.yaml"
  ],
  "dependencies": {
    "pip": [
      "gymnasium[mujoco]>=1.0.0"
    ],
    "components": []
  },
  "compatibility": {
    "theta": ">=2.0.0"
  },
  "parameter_schema": {
