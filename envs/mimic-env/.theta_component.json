{
  "id": "mimic-env",
  "name": "MIMIC-III Clinical Environment Suite",
  "kind": "env",
  "version": "1.1.0",
  "description": "ICU sepsis benchmarks, valuation hooks, and transition interfaces for MIMIC-III.",
  "author": {
    "name": "Theta Clinical Team"
  },
  "created_at": "2026-10-18T00:00:00Z",
  "config_path": "env/mimic.yaml",
  "dependencies": {
    "components": [
      "clinical-timeseries-data",
      "mimic-early-prediction",
      "mimic-clinical-suite"
    ],
    "pip": []
  },
  "paradigms": [
    "supervised",
    "offline_rl"
  ],
  "parameter_schema": {
    "type": "object",
    "properties": {
      "monitor_metric": {
        "type": "string"
      },
      "env_id": {
        "type": "string"
      },
      "offline_only": {
        "type": "boolean"
      },
      "preprocess_on_load": {
        "type": "boolean"
      },
      "gamma": {
        "type": "number"
      },
      "gae_lambda": {
        "type": "number"
      },
      "reward_type": {
        "type": "string"
      },
      "dataset_name": {
        "type": "string"
      },
      "reward_shaping": {
        "type": "object",
        "properties": {
          "ep_ckpt_dir": {
            "type": "string"
          },
          "lambda_coef": {
            "type": "number"
          },
          "gamma": {
            "type": "number"
          },
          "window_hours": {
            "type": "integer"
          },
          "ep_arch": {
            "type": "string"
          },
          "cql_ckpt_dir": {
            "type": "string"
          }
        }
      },
      "default_plots": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "config_paths": [
    "env/mimic.yaml"
  ],
  "storage_version": 3,
  "api_version": 1,
  "capabilities": [
    {
      "id": "mimic-env",
      "kind": "env",
      "entry_point": "environment/env_vectorized.py:VectorizedNudgeEnv",
      "aliases": [
        "mimic"
      ],
      "resource_root": "environment"
    }
  ],
  "payload": {
    "implementations": [
      "environment/env_vectorized.py",
      "environment/generate_expert.py",
      "environment/valuation.py"
    ],
    "resources": [],
    "configs": {
      "env/mimic.yaml": "configs/env/mimic.yaml"
    }
  }
}
