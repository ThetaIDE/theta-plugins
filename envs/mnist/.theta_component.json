{
  "id": "mnist",
  "name": "MNIST Handwritten Digits",
  "kind": "env",
  "version": "1.0.1",
  "description": "Handwritten digits classification benchmark (8x8 mini-MNIST and 28x28 MNIST) supporting supervised, unsupervised, and RL environments.",
  "author": {
    "name": "Theta-IDE Team"
  },
  "tags": [
    "env",
    "mnist",
    "digits",
    "vision",
    "classification",
    "benchmark"
  ],
  "paradigms": [
    "supervised",
    "unsupervised"
  ],
  "config_path": "in/config/env/mnist/digits.yaml",
  "config_paths": [
    "in/config/env/mnist/digits.yaml",
    "in/config/env/mnist/mnist.yaml"
  ],
  "dependencies": {
    "pip": [
      "scikit-learn",
      "numpy",
      "torch"
    ],
    "components": []
  },
  "parameter_schema": {
    "type": "object",
    "properties": {},
    "x-theta-config-schemas": {
      "in/config/env/mnist.yaml": {
        "type": "object",
        "properties": {
          "env_id": {
            "type": "string"
          },
          "environment_source": {
            "type": "string"
          },
          "monitor_metric": {
            "type": "string"
          },
          "dataset_name": {
            "type": "string"
          },
          "obs_dim": {
            "type": "integer"
          },
          "n_actions": {
            "type": "integer"
          },
          "use_sequences": {
            "type": "boolean"
          },
          "val_fraction": {
            "type": "number"
          },
          "batch_size": {
            "type": "integer"
          },
          "default_plots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "in/config/env/digits.yaml": {
        "type": "object",
        "properties": {
          "env_id": {
            "type": "string"
          },
          "environment_source": {
            "type": "string"
          },
          "monitor_metric": {
            "type": "string"
          },
          "dataset_name": {
            "type": "string"
          },
          "obs_dim": {
            "type": "integer"
          },
          "n_actions": {
            "type": "integer"
          },
          "use_sequences": {
            "type": "boolean"
          },
          "val_fraction": {
            "type": "number"
          },
          "batch_size": {
            "type": "integer"
          },
          "default_plots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "storage_version": 2,
  "api_version": 1,
  "capabilities": [
    {
      "id": "mnist",
      "kind": "env",
      "entry_point": "env_vectorized.py:VectorizedEnv",
      "aliases": [
        "mnist/mnist",
        "mnist/digits",
        "digits"
      ],
      "resource_root": "."
    }
  ],
  "payload": {
    "implementations": [
      "env_vectorized.py",
      "__init__.py"
    ],
    "resources": [
      "requirements.txt"
    ],
    "configs": {
      "in/config/env/mnist/digits.yaml": "configs/env/mnist/digits.yaml",
      "in/config/env/mnist/mnist.yaml": "configs/env/mnist/mnist.yaml"
    }
  }
}
